# Postgres connection string. Locally this points at a local Postgres; in
# production, use Supabase's "Transaction pooler" string (port 6543) so
# serverless functions don't exhaust the connection limit.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Email (Resend). Optional - falls back to server-log "sends" when unset,
# so the full decision/notification flow is demoable without a live key.
RESEND_API_KEY=""

# File storage (Vercel Blob). REQUIRED in both production and local dev if
# you want to test attachments - the browser uploads files directly to Blob
# (see src/app/api/blob-upload/route.ts) rather than sending them through a
# Server Action, since Vercel Functions hard-cap request bodies at 4.5MB.
# Text-only submissions work fine without this set. Auto-populated if you
# connect a Blob store to the project in the Vercel dashboard (Storage tab).
BLOB_READ_WRITE_TOKEN=""
