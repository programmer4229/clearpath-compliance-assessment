# Postgres connection string. Locally this points at a local Postgres; in
# production, use Supabase's "Transaction pooler" string (port 6543) so
# serverless functions don't exhaust the connection limit.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session signing key (see src/lib/session.ts). REQUIRED — the app throws on
# any login/signup/session check without it. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=""

# Email (Resend). Optional - falls back to server-log "sends" when unset,
# so the full decision/notification flow is demoable without a live key.
RESEND_API_KEY=""

# File storage (Vercel Blob). Only needed if you want to test attachments -
# the browser uploads files directly to Blob (see
# src/app/api/blob-upload/route.ts) rather than sending them through a
# Server Action, since Vercel Functions hard-cap request bodies at 4.5MB.
# Text-only submissions work fine without any of this set.
#
# Uses the OIDC/presigned-URL flow, not a static token: connecting a Blob
# store to the project in the Vercel dashboard (Storage tab) auto-populates
# BLOB_STORE_ID and BLOB_WEBHOOK_PUBLIC_KEY in production, which is all that's
# needed there. See src/app/api/blob-upload/route.ts for details, including
# what's required to exercise this locally.
BLOB_STORE_ID=""
BLOB_WEBHOOK_PUBLIC_KEY=""
